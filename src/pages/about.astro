---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import Media from '../components/Media.astro';
import crystals from '../assets/photos/crystals-closeup.jpg';
import formPhoto from '../assets/photos/process-form.jpg';
import glazePhoto from '../assets/photos/process-glaze.jpg';
import firePhoto from '../assets/photos/process-fire.jpg';
import carving from '../assets/photos/studio-carving.jpg';
import piercing from '../assets/photos/studio-piercing.jpg';
import plates from '../assets/photos/studio-plates.jpg';
import cylinder from '../assets/photos/studio-printed-cylinder.jpg';
import gasKiln from '../assets/photos/studio-gas-kiln.jpg';
import { site } from '../site.config';
import { photo } from '../lib/photos';

const portrait = photo(site.portrait.image, true);

const steps = [
  {
    title: 'Form',
    text: 'Each piece is thrown, slip cast or printed in clay, then bisque fired. Crystalline pieces get a pedestal so the running glaze has somewhere to go.',
    image: formPhoto,
    alt: 'Bisque-fired bottles, cups and a bowl, each standing on its own pedestal',
  },
  {
    title: 'Glaze',
    text: 'Glazes are mixed by hand from raw materials. A new recipe starts as rows of test tiles, often nearly identical except for the colorant.',
    image: glazePhoto,
    alt: 'Dozens of small glazed test tiles lined up in rows before firing',
  },
  {
    title: 'Fire',
    text: 'The kiln holds at set temperatures on the way down, and that is where the crystals grow. The fired tiles show what each colorant does.',
    image: firePhoto,
    alt: 'A tray of fired crystalline test tiles in blues, greens, browns and whites',
  },
];

const studio = [
  { image: carving, alt: 'Hands carving concentric rings into a leather-hard plate on the wheel', caption: 'Carving rings into a plate' },
  { image: piercing, alt: 'Cutting openings into a leather-hard bowl with a small knife', caption: 'Piercing a bowl by hand' },
  { image: plates, alt: 'Freshly thrown plates drying on their bats', caption: 'Plates drying on their bats' },
  { image: cylinder, alt: 'A 3D-printed clay cylinder with a twisting ridged surface, before firing', caption: 'A printed cylinder, before firing' },
  { image: gasKiln, alt: 'The brick gas kiln stacked floor to ceiling with unglazed jugs, bowls and cups', caption: 'The Clay Art Guild\'s gas kiln, which I help load and unload' },
];
---

<Base title="Bio" description={`Kieran Ryan makes crystalline-glazed porcelain and stoneware in ${site.location}.`} image={crystals}>
  <h1 class="visually-hidden">Bio</h1>

  <div class="section container">
    <div class="portrait-solo">
      <Media image={portrait} alt={site.portrait.alt} aspect="4 / 5" label="Portrait" sizes="(max-width: 600px) 100vw, 36rem" eager />
    </div>
  </div>

  <section class="section container narrow" aria-label="Bio">
    <div class="prose">
      <p>
        I'm a ceramic artist in East Hampton, New York, and something of a glaze geek. Most of my
        work is porcelain and stoneware finished in crystalline glaze, a process where zinc and
        silica crystals grow across the surface while the kiln cools. The chemistry and the firing
        schedule set the conditions. The crystals decide the rest, which is why no two pieces match.
      </p>
      <p>
        I also pierce bowls and platters by hand, slip cast, and 3D print in clay. I teach
        crystalline glaze workshops at the <a href="https://www.instagram.com/clayarthamptons/" target="_blank" rel="noopener">Clay Art Guild of the Hamptons</a> and
        classes at <a href="https://www.instagram.com/muditaceramicsschool/" target="_blank" rel="noopener">Mudita Ceramics School</a>.
        In 2025 my work was at the <a href="/exhibitions/">Parrish Art Museum holiday market</a>.
      </p>
    </div>
  </section>

  <section class="section container" aria-labelledby="process-heading">
    <div class="section-head">
      <h2 class="page-title" id="process-heading">Process</h2>
    </div>
    <ol class="steps">
      {steps.map((step) => (
        <li>
          <Media image={step.image} alt={step.alt} aspect="1 / 1" sizes="(max-width: 760px) 100vw, 33vw" />
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section container" aria-labelledby="studio-heading">
    <div class="section-head">
      <h2 class="page-title" id="studio-heading">In the studio</h2>
    </div>
    <div class="photo-grid">
      {studio.map((p) => (
        <figure>
          <Media image={p.image} alt={p.alt} aspect="4 / 5" sizes="(max-width: 480px) 100vw, (max-width: 760px) 50vw, 33vw" />
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <div class="section">
    <Banner
      heading="h2"
      below
      href="/work/"
      image={crystals}
      alt="Close-up of pale gold zinc silicate crystals spreading across a glazed surface"
      title="See the work"
    />
  </div>
</Base>
