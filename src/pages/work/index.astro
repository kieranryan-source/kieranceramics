---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Work" description="Crystalline-glazed porcelain and stoneware, pierced bowls and printed clay by Kieran Ryan.">
  <section class="container page-head">
    <h1 class="page-title">Work</h1>
    <p class="lead">Crystalline glazes, pierced porcelain, printed clay and slip casting.</p>
  </section>

  <section class="section container" aria-label="All pieces">
    <div class="gallery">
      {work.map((piece, i) => <WorkCard piece={piece} eager={i < 3} />)}
    </div>
  </section>
</Base>
