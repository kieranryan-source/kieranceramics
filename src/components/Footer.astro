---
import { site } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <nav class="footer-nav" aria-label="Footer">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={site.instagram.url} rel="me noopener" target="_blank">Instagram</a>
      {site.email && <a href={`mailto:${site.email}`}>Email</a>}
    </nav>
    <p class="footer-note">&copy; {year} {site.name}. Made in {site.location}.</p>
  </div>
</footer>
