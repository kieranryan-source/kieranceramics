---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import pressList from '../data/press.json';
import Media from '../components/Media.astro';
import mockup from '../assets/photos/gallery-mockup.jpg';

// Articles, interviews and features from src/data/press.json. The Press section stays hidden while it's empty.
interface PressItem {
  title: string;        // the headline
  publication: string;  // e.g. "The East Hampton Star"
  when: string;         // e.g. "March 2027"
  url?: string;
  order?: number;
}

const exhibitions = (await getCollection('exhibitions')).sort((a, b) => a.data.order - b.data.order);
const press = (pressList as PressItem[]).toSorted((a, b) => (a.order ?? 100) - (b.order ?? 100));
---

<Base title="Exhibitions" description={`Exhibitions and markets showing crystalline ceramics by Kieran Ryan, ${site.location}.`}>
  <section class="container page-head narrow">
    <h1 class="page-title">Exhibitions</h1>
  </section>

  <figure class="section container mockup">
    <Media
      image={mockup}
      alt="Digital mock-up: four of Kieran's pieces, a teal bottle with cups and blue, gold and turquoise bottles, on white plinths in an imagined gallery"
      aspect="2 / 1"
      sizes="(max-width: 1536px) 100vw, 1440px"
      eager
    />
    <figcaption>Digital mock-up of real pieces in an imagined gallery, not a photo of an exhibition.</figcaption>
  </figure>

  <section class="section container narrow" aria-label="Exhibitions">
    <div class="list">
      {exhibitions.map((e) => {
        const Row = e.data.url ? 'a' : 'div';
        return (
          <Row class="list-row" href={e.data.url} target={e.data.url ? '_blank' : undefined} rel={e.data.url ? 'noopener' : undefined}>
            <span class="primary">{e.data.title}</span>
            <span class="secondary">{e.data.place}</span>
            <span class="tertiary">{e.data.when}</span>
          </Row>
        );
      })}
    </div>
  </section>

  {press.length > 0 && (
    <section class="section container narrow" aria-labelledby="press-heading">
      <div class="section-head">
        <h2 class="page-title" id="press-heading">Press</h2>
      </div>
      <div class="list">
        {press.map((p) => {
          const Row = p.url ? 'a' : 'div';
          return (
            <Row class="list-row" href={p.url} target={p.url ? '_blank' : undefined} rel={p.url ? 'noopener' : undefined}>
              <span class="primary">{p.title}</span>
              <span class="secondary">{p.publication}</span>
              <span class="tertiary">{p.when}</span>
            </Row>
          );
        })}
      </div>
    </section>
  )}
</Base>
