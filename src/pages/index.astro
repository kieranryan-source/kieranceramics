---
import { allWork } from '../lib/work';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import Newsletter from '../components/Newsletter.astro';
import Announcement from '../components/Announcement.astro';
import Media from '../components/Media.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../site.config';
import { photo } from '../lib/photos';
import tiles from '../assets/photos/workshop-tiles.jpg';

const work = await allWork();
// Six tiles fill two rows of the gallery: featured pieces first, then the rest in order
const selected = [...work.filter((p) => p.data.featured), ...work.filter((p) => !p.data.featured)].slice(0, 6);
const heroImage = photo(site.hero.image);
const portrait = photo(site.portrait.image, true);
---

<Base image={heroImage}>
  <Announcement />
  <Banner
    tall
    plain
    image={heroImage}
    alt={site.hero.alt}
    title={site.hero.title}
    subtitle={site.hero.subtitle}
    button={site.hero.button}
  />

  <section class="section container" aria-label="About me">
    <div class="intro-split">
      <a class="portrait" href="/about/">
        <Media image={portrait} alt={site.portrait.alt} aspect="4 / 5" label="Portrait" sizes="(max-width: 760px) 22rem, 30vw" />
      </a>
      <div>
        <p class="lead">
          I'm Kieran, a ceramic artist in East Hampton. Each glaze starts as chemistry I mix by hand:
          zinc, silica and a few colorants. The firing does the rest, growing crystals across the
          surface over hours of slow cooling. I can steer it, but I can't repeat it, so every piece
          is the only one of its kind.
        </p>
        <a class="link" href="/about/">More about me and the process</a>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 class="page-title" id="work-heading">Selected work</h2>
      <a class="link" href="/work/">See all {work.length} pieces</a>
    </div>
    <div class="gallery">
      {selected.map((piece) => <WorkCard piece={piece} />)}
    </div>
  </section>

  <div class="section">
    <Banner
      heading="h2"
      below
      href="/workshops/"
      image={tiles}
      focus="50% 50%"
      alt="Three crystalline test pieces on glaze catchers, in teal, deep blue and mauve"
      title="Crystalline glaze workshops"
      subtitle="Learn to mix, apply and fire glazes that grow their own crystals"
    />
  </div>

  <section class="section container narrow" aria-labelledby="cta-heading" style="text-align: center">
    <h2 class="page-title" id="cta-heading">Commissions</h2>
    <p class="lead muted" style="margin-top: 1rem">
      Looking for a particular color, a set made to order, or a piece for a gift?
    </p>
    <p style="margin-top: 2rem"><a class="button quiet" href="/commissions/">How commissions work</a></p>
  </section>

  <Newsletter />
</Base>
