---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import BuyButton from '../../components/BuyButton.astro';
import { categories, categoryHref } from '../../lib/categories';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((piece, i) => ({
    params: { slug: piece.id },
    props: { piece, prev: work[i - 1], next: work[i + 1] },
  }));
}

const { piece, prev, next } = Astro.props;
const { title, year, process, dimensions, image, imageAlt, aspect, morePhotos, shop } = piece.data;
const pieceCategories = categories.filter((c) => piece.data.categories.includes(c.id));
const { Content } = await render(piece);

const availability = !shop ? null : shop.status === 'sold' ? 'Sold' : 'Available';

// Extra photos fill the page width below: one large, then pairs side by side.
// If a pair would be left with one photo, that last photo goes large too.
const isWide = (i: number) => i === 0 || (i === morePhotos.length - 1 && i % 2 === 1);
---

<Base title={title} description={`${title}, ${process}, ${year}. By Kieran Ryan.`} image={image}>
  <article class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/work/">Work</a>
      <span aria-hidden="true">/</span>
      <a href={categoryHref(pieceCategories[0].id)}>{pieceCategories[0].label}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>

    <div class="piece">
      <div class="piece-photo">
        <Media image={image} alt={imageAlt ?? title} aspect={aspect} sizes="(max-width: 860px) 100vw, 58vw" eager />
      </div>

      <div class="piece-info">
        <h1 class="page-title">{title}</h1>
        <BuyButton piece={piece} />

        <dl class="facts">
          <div><dt>Year</dt><dd>{year}</dd></div>
          <div><dt>Process</dt><dd>{process}</dd></div>
          <div>
            <dt>Category</dt>
            <dd>{pieceCategories.map((c, i) => <>{i > 0 && ', '}<a href={categoryHref(c.id)}>{c.label}</a></>)}</dd>
          </div>
          {dimensions && <div><dt>Size</dt><dd>{dimensions}</dd></div>}
          {availability && <div><dt>Availability</dt><dd>{availability}</dd></div>}
        </dl>

        <div class="prose"><Content /></div>
      </div>
    </div>

    {morePhotos.length > 0 && (
      <div class="detail-photos">
        {morePhotos.map((p, i) => (
          <div class:list={['detail', { wide: isWide(i) }]}>
            <Media
              image={p.image}
              alt={p.alt ?? `${title}, photo ${i + 2}`}
              aspect={isWide(i) ? undefined : '3 / 2'}
              sizes={isWide(i) ? '(max-width: 1536px) 100vw, 1440px' : '(max-width: 760px) 100vw, 50vw'}
            />
          </div>
        ))}
      </div>
    )}

    <nav class="section" aria-label="More work">
      <div class="pager">
        {prev ? <a href={`/work/${prev.id}/`}>&larr; {prev.data.title}</a> : <a href="/work/">&larr; All work</a>}
        {next ? <a href={`/work/${next.id}/`}>{next.data.title} &rarr;</a> : <a href="/work/">All work &rarr;</a>}
      </div>
    </nav>
  </article>
</Base>
