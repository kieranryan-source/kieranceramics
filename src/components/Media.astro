---
// Shows a piece's photo, or a quiet placeholder in the right shape until a photo exists.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  aspect?: string;
  sizes?: string;
  eager?: boolean;
  label?: string;
}

const { image, alt = '', aspect, sizes = '(max-width: 760px) 100vw, 50vw', eager = false, label } = Astro.props;
const ratio = aspect ?? (image ? `${image.width} / ${image.height}` : '4 / 5');
const style = `aspect-ratio: ${ratio}; --ratio: (${ratio})`;
---

{image ? (
  <div class="media" style={style}>
    <Image
      src={image}
      alt={alt}
      widths={[480, 800, 1200, 1800]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
  </div>
) : (
  <div class="media placeholder" style={style} role="img" aria-label={alt || 'Photo to come'}>
    <span>{label ?? 'Photo to come'}</span>
  </div>
)}
