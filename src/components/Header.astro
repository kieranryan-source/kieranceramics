---
import { site } from '../site.config';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href="/" aria-label={`${site.name}, ${site.tagline}, home`}>
      <span class="wordmark-name">{site.name}</span>
      <span class="wordmark-tag">{site.tagline}</span>
    </a>

    <nav class="nav" aria-label="Main">
      {site.nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <details class="menu">
      <summary><span class="open">Menu</span><span class="close">Close</span></summary>
      <nav class="menu-panel" aria-label="Main">
        {site.nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
