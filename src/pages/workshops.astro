---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import { site } from '../site.config';
import tiles from '../assets/photos/workshop-tiles.jpg';

const workshops = (await getCollection('workshops')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Workshops" description={`Crystalline glaze workshops and ceramics classes taught by Kieran Ryan in ${site.location}.`} image={tiles}>
  <Banner
    image={tiles}
    focus="50% 62%"
    alt="Three crystalline test pieces on glaze catchers, in teal, cobalt blue and mauve"
    title="Workshops"
  />

  <section class="section container narrow" aria-label="About the workshops">
    <p class="lead">
      Crystalline glazes have a reputation for being difficult. They're mostly patient chemistry,
      and the workshops walk you through it from mixing to firing.
    </p>
  </section>

  <section class="section container narrow" aria-label="Where I teach">
    <div class="list">
      {workshops.map((w) => (
        <div class="list-row">
          <span class="primary">{w.data.title}</span>
          <span class="secondary">
            {w.data.hostUrl ? <a class="link" href={w.data.hostUrl} target="_blank" rel="noopener">{w.data.host}</a> : w.data.host}
          </span>
          <span class="tertiary">{w.data.summary}</span>
          <span class="tertiary">{w.data.schedule}</span>
        </div>
      ))}
    </div>
    <p class="muted" style="margin-top: 2.5rem; text-align: center; font-size: var(--step--1)">
      New dates go up on <a class="link" href={site.instagram.url} target="_blank" rel="noopener">Instagram</a> first.
      For a private session or a group, <a class="link" href="/contact/">get in touch</a>.
    </p>
  </section>
</Base>
