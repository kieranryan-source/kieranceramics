---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import { site } from '../site.config';
import tiles from '../assets/photos/workshop-tiles.jpg';

const workshops = (await getCollection('workshops')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Workshops" description={`Crystalline glaze workshops and ceramics classes taught by Kieran Ryan in ${site.location}.`} image={tiles}>
  <section class="container grid piece-head">
    <h1 class="heading">Learn to grow crystals</h1>
    <p class="intro" style="grid-column: 5 / -1">
      Crystalline glazes have a reputation for being difficult. They're mostly patient chemistry,
      and the workshops walk you through it from mixing to firing.
    </p>
  </section>

  <div class="container piece-media">
    <div class="grid split">
      <div class="content">
        <Media image={tiles} alt="Three crystalline test pieces on glaze catchers, in teal, cobalt blue and mauve" aspect="3 / 2" sizes="(max-width: 760px) 100vw, 66vw" eager />
      </div>
    </div>
  </div>

  <section class="section container" aria-label="Where I teach">
    <div class="index">
      {workshops.map((w) => (
        <div class="index-row">
          <span class="primary">{w.data.title}</span>
          <span class="secondary">
            {w.data.hostUrl ? <a class="link" href={w.data.hostUrl} target="_blank" rel="noopener">{w.data.host}</a> : w.data.host}
            <br />{w.data.summary}
          </span>
          <span class="tertiary">{w.data.schedule}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section container" aria-label="Dates">
    <div class="grid split">
      <div class="content prose">
        <p>
          New workshop dates go up on <a href={site.instagram.url} target="_blank" rel="noopener">Instagram</a> first.
          For a private session or a group, <a href="/contact/">get in touch</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
