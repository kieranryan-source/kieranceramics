---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../site.config';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const available = work.filter((p) => p.data.shop?.status === 'available');
const sold = work.filter((p) => p.data.shop?.status === 'sold');
// Pieces for sale come first, sold pieces after with a "Sold" tag
const listed = [...available, ...sold];
---

<Base title="Shop" description="One-of-a-kind crystalline pieces by Kieran Ryan.">
  <section class="container page-head narrow">
    <h1 class="page-title">Shop</h1>
    <p class="lead">
      Every piece is one of a kind. Once it sells, it's gone.
      {available.length === 0 && (
        <>
          <br />New pieces go up on <a class="link" href={site.instagram.url} target="_blank" rel="noopener">Instagram</a> first.
        </>
      )}
    </p>
    <p class="muted" style="margin-top: 1rem; font-size: var(--step--1)">
      <a class="link" href="/shop-information/">Shipping, care and returns</a>
    </p>
  </section>

  {listed.length > 0 && (
    <section class="section container" aria-label="Pieces">
      <div class="gallery">
        {listed.map((piece, i) => <WorkCard piece={piece} showPrice eager={i < 3} />)}
      </div>
    </section>
  )}
</Base>
