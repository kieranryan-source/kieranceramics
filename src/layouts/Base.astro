---
import '@fontsource-variable/work-sans/wght.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/libre-franklin/wght.css';
import '@fontsource-variable/dm-sans/wght.css';
import '../styles/theme.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FontPicker from '../components/FontPicker.astro';
import { site } from '../site.config';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultShareImage from '../assets/photos/cobalt-bottle.jpg';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata; // shown when the page is shared in messages and social posts
}

const { title, description = site.description, image = defaultShareImage } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url);
const share = await getImage({ src: image, width: 1200, format: 'jpg' });
const shareUrl = new URL(share.src, site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Font preview (temporary): apply the chosen font before the page paints.
      try {
        const f = new URLSearchParams(location.search).get('font') || localStorage.getItem('font-preview');
        if (f) document.documentElement.dataset.font = f;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FontPicker />
  </body>
</html>
