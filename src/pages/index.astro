---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../site.config';
import { slotAspect, slotSizes } from '../lib/work-grid';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((p) => p.data.featured).slice(0, 4);
const heroPiece = work.find((p) => p.id === site.heroPiece) ?? featured[0];
const workshops = (await getCollection('workshops')).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <section class="hero container" aria-labelledby="name">
    <div class="grid">
      <p class="label">(Intro)</p>
      <p class="intro">
        I make porcelain and stoneware, most of it finished in crystalline glaze. The crystals grow
        in the kiln on their own terms, so every piece is the only one of its kind.
      </p>

      <h1 class="name display rise" id="name">
        <span class="line"><span>Kieran</span></span>
        <span class="line"><span>Ryan</span></span>
      </h1>

      <a class="figure" href={heroPiece ? `/work/${heroPiece.id}/` : '/work/'}>
        <Media
          image={heroPiece?.data.image}
          alt={heroPiece?.data.imageAlt ?? heroPiece?.data.title}
          aspect="4 / 5"
          sizes="(max-width: 560px) 100vw, (max-width: 960px) 75vw, 30vw"
          eager
        />
      </a>

      <dl class="facts">
        <div>
          <dt>Practice</dt>
          <dd>Crystalline glazes<br />Pierced porcelain<br />Clay printing<br />Slip casting</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>{site.location}</dd>
        </div>
        <div>
          <dt>Teaching</dt>
          <dd><span class="status-dot" aria-hidden="true"></span>Crystalline workshops</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section container" aria-labelledby="about-heading">
    <div class="grid split">
      <h2 class="label" id="about-heading">(About)</h2>
      <div class="content">
        <p class="statement" data-fill>
          Each glaze starts as chemistry I mix by hand: zinc, silica and a few colorants. The firing
          does the rest, growing crystals across the surface over hours of slow cooling. I can steer
          it, but I can't repeat it. What you take home happened once.
        </p>
        <p style="margin-top: 2rem"><a class="link" href="/about/">More about the work</a></p>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="work-heading">
    <div class="grid section-head">
      <p class="label">(Selected work)</p>
      <h2 class="heading" id="work-heading">From the kiln</h2>
      <a class="more link" href="/work/">All work ({work.length})</a>
    </div>
    <div class="grid work-grid">
      {featured.map((piece, i) => (
        <WorkCard piece={piece} aspect={slotAspect(i)} sizes={slotSizes(i)} />
      ))}
    </div>
  </section>

  <section class="section container" aria-labelledby="workshops-heading">
    <div class="grid section-head">
      <p class="label">(Workshops)</p>
      <h2 class="heading" id="workshops-heading">Learn to grow crystals</h2>
      <a class="more link" href="/workshops/">Workshop details</a>
    </div>
    <div class="index">
      {workshops.map((w) => (
        <a class="index-row" href="/workshops/">
          <span class="primary">{w.data.title}</span>
          <span class="secondary">{w.data.host}</span>
          <span class="tertiary">{w.data.schedule}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section container cta" aria-labelledby="cta-heading">
    <div class="grid split">
      <p class="label">(Contact)</p>
      <div class="content">
        <h2 class="heading" id="cta-heading">Looking for a piece, or a commission?</h2>
        <a class="link" href="/contact/">Get in touch</a>
      </div>
    </div>
  </section>
</Base>
