---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---

<Base title="Contact" description="Get in touch with Kieran Ryan about a piece, a commission or a workshop.">
  <section class="container page-head narrow">
    <h1 class="page-title">Get in touch</h1>
    <p class="lead">
      Ask about a piece, a commission or a workshop.
      <span id="asking" class="muted" hidden></span>
    </p>
  </section>

  <section class="section container narrow" aria-label="Ways to reach me">
    <div class="list">
      {site.email && (
        <a class="list-row" href={`mailto:${site.email}`} id="email-row">
          <span class="primary">Email</span>
          <span class="secondary">{site.email}</span>
          <span class="tertiary">Best for orders</span>
        </a>
      )}
      <a class="list-row" href={site.instagram.url} target="_blank" rel="noopener">
        <span class="primary">Instagram</span>
        <span class="secondary">{site.instagram.handle}</span>
        <span class="tertiary">New work posted first</span>
      </a>
    </div>
  </section>
</Base>

<script>
  // When someone arrives from "Ask about this piece", name the piece and prefill the email subject.
  const piece = new URLSearchParams(location.search).get('piece');
  if (piece) {
    const note = document.getElementById('asking');
    if (note) {
      note.textContent = ` You're asking about: ${piece}.`;
      note.hidden = false;
    }
    const row = document.getElementById('email-row') as HTMLAnchorElement | null;
    if (row) row.href += `?subject=${encodeURIComponent(piece)}`;
  }
</script>
