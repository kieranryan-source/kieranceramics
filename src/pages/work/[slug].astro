---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import BuyButton from '../../components/BuyButton.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((piece, i) => ({
    params: { slug: piece.id },
    props: { piece, prev: work[i - 1], next: work[i + 1] },
  }));
}

const { piece, prev, next } = Astro.props;
const { title, year, process, dimensions, image, imageAlt, aspect, shop } = piece.data;
const { Content } = await render(piece);

const availability = !shop ? null : shop.status === 'sold' ? 'Sold' : 'Available';
---

<Base title={title} description={`${title}, ${process}, ${year}. By Kieran Ryan.`} image={image}>
  <article class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/work/">Work</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>

    <div class="piece">
      <div class="piece-photo">
        <Media image={image} alt={imageAlt ?? title} aspect={aspect} sizes="(max-width: 860px) 100vw, 58vw" eager />
      </div>

      <div class="piece-info">
        <h1 class="page-title">{title}</h1>
        <BuyButton piece={piece} />

        <dl class="facts">
          <div><dt>Year</dt><dd>{year}</dd></div>
          <div><dt>Process</dt><dd>{process}</dd></div>
          {dimensions && <div><dt>Size</dt><dd>{dimensions}</dd></div>}
          {availability && <div><dt>Availability</dt><dd>{availability}</dd></div>}
        </dl>

        <div class="prose"><Content /></div>
      </div>
    </div>

    <nav class="section" aria-label="More work">
      <div class="pager">
        {prev ? <a href={`/work/${prev.id}/`}>&larr; {prev.data.title}</a> : <a href="/work/">&larr; All work</a>}
        {next ? <a href={`/work/${next.id}/`}>{next.data.title} &rarr;</a> : <a href="/work/">All work &rarr;</a>}
      </div>
    </nav>
  </article>
</Base>
