{
  // Cloudflare Workers config: serves the built static site from dist/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kieranceramics",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Lets Cloudflare build a preview of each pull request (it runs `npx wrangler preview`)
  "previews": {}
}
