---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../site.config';
import { photo } from '../lib/photos';
import tiles from '../assets/photos/workshop-tiles.jpg';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
// Six tiles fill two rows of the gallery: featured pieces first, then the rest in order
const selected = [...work.filter((p) => p.data.featured), ...work.filter((p) => !p.data.featured)].slice(0, 6);
const heroImage = photo(site.hero.image);
---

<Base image={heroImage}>
  <Banner
    tall
    image={heroImage}
    alt={site.hero.alt}
    title={site.hero.title}
    subtitle={site.hero.subtitle}
    button={site.hero.button}
  />

  <section class="section container narrow" aria-label="About the work">
    <p class="lead">
      Each glaze starts as chemistry I mix by hand: zinc, silica and a few colorants. The firing
      does the rest, growing crystals across the surface over hours of slow cooling. I can steer
      it, but I can't repeat it, so every piece is the only one of its kind.
    </p>
  </section>

  <section class="section container" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 class="page-title" id="work-heading">Selected work</h2>
      <a class="link" href="/work/">See all {work.length} pieces</a>
    </div>
    <div class="gallery">
      {selected.map((piece) => <WorkCard piece={piece} />)}
    </div>
  </section>

  <div class="section">
    <Banner
      heading="h2"
      href="/workshops/"
      image={tiles}
      focus="50% 62%"
      alt="Three crystalline test pieces on glaze catchers, in teal, cobalt blue and mauve"
      title="Crystalline glaze workshops"
      subtitle="Learn to mix, apply and fire glazes that grow their own crystals"
    />
  </div>

  <section class="section container narrow" aria-labelledby="cta-heading" style="text-align: center">
    <h2 class="page-title" id="cta-heading">Commissions and enquiries</h2>
    <p class="lead muted" style="margin-top: 1.25rem">
      Looking for a particular piece, a color, or a set made to order?
    </p>
    <p style="margin-top: 2rem"><a class="button quiet" href="/contact/">Get in touch</a></p>
  </section>
</Base>
